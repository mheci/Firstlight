# labwc environment for Budgie Desktop - NVIDIA + input + cursor
# The budgie labwc bridge manages XKB_DEFAULT_* / XCURSOR_* / LANG / LC_* and
# preserves every other variable here.

# Keyboard / input
XKB_DEFAULT_LAYOUT=us
# Cursor (Adwaita is always installed)
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24

# NVIDIA - Wayland native (nvidia-drm GBM + GLVND for XWayland GL)
GBM_BACKEND=nvidia-drm
__GLX_VENDOR_LIBRARY_NAME=nvidia

# Uncomment only if a specific issue appears:
# Disappearing/flickering cursor:
# WLR_NO_HARDWARE_CURSORS=1
# Modeset failure at max resolution/refresh:
# WLR_DRM_NO_MODIFIERS=1
# Tearing artifacts with atomic modesetting (allowTearing):
# WLR_DRM_NO_ATOMIC=1
